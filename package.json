{
  "name": "@devkade/pi-opentelemetry",
  "version": "0.1.4",
  "description": "OpenTelemetry trace + metrics + diagnostics extension for Pi Coding Agent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devkade/pi-opentelemetry.git"
  },
  "homepage": "https://github.com/devkade/pi-opentelemetry#readme",
  "bugs": {
    "url": "https://github.com/devkade/pi-opentelemetry/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "opentelemetry",
    "otel",
    "telemetry"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "release:check": "npm test && npm run typecheck && npm pack --dry-run",
    "prepublishOnly": "npm run release:check"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.18"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/semantic-conventions": "^1.39.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
